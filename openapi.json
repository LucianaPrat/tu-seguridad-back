    "/api/v1/events": {
      "get": {
        "operationId": "EventsController_query_v1",
        "parameters": [
          {
            "name": "cameraId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "zoneId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "eventType",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PERSON_ENTERED_ZONE",
                "PERSON_EXITED_ZONE"
              ]
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "ISO 8601 date-time, occurredAt >= from",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "ISO 8601 date-time, occurredAt <= to",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Silently clamped to [1, 1000]",
            "schema": {
              "default": 100,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "events"
        ]
      }
    },
