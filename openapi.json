          "pollingIntervalSeconds": {
            "type": "number",
            "default": 5,
            "minimum": 1,
            "maximum": 3600
          },
          "confidenceThreshold": {
            "type": "number",
            "default": 0.45,
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "PointDto": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "CreateZoneDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "zone_lobby",
            "pattern": "^zone_[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "example": "Lobby"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "polygon": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PointDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "polygon"
        ]
      },
      "UpdateZoneDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Lobby"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "polygon": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PointDto"
            }
          }
        }
      },
      "ValidateZoneDto": {
        "type": "object",
        "properties": {
          "polygon": {
            "type": "array",
            "items": {
