            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateCameraDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "camera_01",
            "pattern": "^camera_[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "example": "Front door"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "snapshotUrl": {
            "type": "string",
            "example": "http://user:pass@192.168.1.50/snapshot.jpg"
          },
          "pollingIntervalSeconds": {
            "type": "number",
            "default": 5,
            "minimum": 1,
            "maximum": 3600
          },
          "confidenceThreshold": {
            "type": "number",
            "default": 0.45,
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "name",
          "snapshotUrl"
        ]
      },
      "UpdateCameraDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Front door"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "snapshotUrl": {
            "type": "string",
            "example": "http://user:pass@192.168.1.50/snapshot.jpg"
