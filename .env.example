NODE_ENV=development            # development | test | production
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8443   # comma-separated allowlist (Vite dev servers)
LOG_LEVEL=info

# Auth
# Every `change-me` below is a development placeholder, and the schema rejects it
# outright when NODE_ENV=production — a boot on one of these would sign tokens
# with a secret published in this repo. Same for the DVR key further down.
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me        # used only by prisma seed (hashed with bcrypt)
                                # required in production, min 16 chars: the seeded admin owns the space

# Database (MySQL, local instance already running)
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/tu-seguridad
DATABASE_URL_TEST=mysql://USER:PASSWORD@127.0.0.1:3306/tu-seguridad-test
SHADOW_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/tu-seguridad-shadow
# 32-byte base64 key; required in production, where this all-zero placeholder is
# rejected by its decoded bytes (every base64 spelling of it, not just this one).
# Generate with: openssl rand -base64 32. Rotate outside the database.
DVR_PASSWORD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# face-auth detection API (upstream)
FACE_AUTH_API_URL=https://api.face-auth.me
FACE_AUTH_DOMAIN=change-me
FACE_AUTH_CLIENT_TOKEN=change-me
DETECT_TIMEOUT_MS=10000

# DVR (recorder the cameras are discovered from)
DVR_TIMEOUT_MS=5000             # connectivity test + channel discovery
DVR_RTSP_PORT=554               # RTSP is a separate service from the ISAPI base URL
DVR_RTSP_STREAM=sub             # sub | main — the recorder uplink carries every viewer

# Live streaming (opt-in). false = GET /cameras/:id/live answers CONFLICT and no
# media server is contacted. Needs a MediaMTX with `authMethod: http` pointed at
# POST /api/v1/streaming/authorize — see docs/decisions/002-hls-live-streaming.md.
MEDIAMTX_ENABLED=false
MEDIAMTX_API_URL=http://127.0.0.1:9997    # Control API — private, authenticates nobody
MEDIAMTX_PUBLIC_URL=http://127.0.0.1:8888 # HLS base the browser reaches
MEDIAMTX_TIMEOUT_MS=5000

# Detection pipeline
POLLING_ENABLED=false           # master switch for the scheduler (off in dev by default)
POLLING_INTERVAL_SECONDS=5      # one tick per space; cameras have no per-camera interval
SNAPSHOT_TIMEOUT_MS=5000
SNAPSHOT_MAX_BYTES=2000000      # rejected before the MySQL write; MEDIUMBLOB caps at 16777215
ENTER_CONSECUTIVE_POLLS=2
EXIT_CONSECUTIVE_POLLS=3

# Throttling (inbound)
THROTTLE_TTL_SECONDS=1
THROTTLE_LIMIT=10

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=tu-seguridad-back

# Error tracking (opt-in). Leave unset to disable — no Sentry network activity.
SENTRY_DSN=

# Mail (local dev: mailpit container — docs/BEST_PRACTICES.md)
MAIL_ENABLED=false              # master switch; false = credentials are only logged
SMTP_HOST=127.0.0.1
SMTP_PORT=1025                  # mailpit; 465 = implicit TLS, 587 = STARTTLS
SMTP_USER=                      # empty for mailpit, it accepts no authentication
SMTP_PASSWORD=                  # never commit a real value
MAIL_FROM=Tu Seguridad <no-reply@tu-seguridad.local>
APP_BASE_URL=http://localhost:5173   # origin the emailed links point at
